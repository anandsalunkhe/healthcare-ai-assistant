# ============================================================
# Healthcare AI Assistant — environment configuration template
# 1. Copy to .env:  cp .env.example .env
# 2. Fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Weaviate ──────────────────────────────────────────────────
# In Docker Compose, leave as "weaviate" (service name).
# For local dev (outside Docker), change to "localhost".
WEAVIATE_HOST=weaviate
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# ── Primary LLM (Ollama) ──────────────────────────────────────
# In Docker Compose, leave as http://ollama:11434.
# For local dev (outside Docker), change to http://localhost:11434.
OLLAMA_BASE_URL=http://ollama:11434
LOCAL_MODEL_NAME=qwen3:8b

# ── Fallback LLM (Gemini 2.5 Flash) ──────────────────────────
# Used automatically if Ollama is unavailable or OOM.
# Leave blank to disable the cloud fallback.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash

# ── Cloud Embedding Fallback ─────────────────────────────────
# Used if local BAAI/bge-m3 fails to load or download.
GEMINI_EMBED_MODEL_NAME=text-embedding-004

# ── Embedding + reranking models ─────────────────────────────
EMBED_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# ── RAG pipeline tuning ───────────────────────────────────────
RETRIEVER_INITIAL_K=15
RETRIEVER_FINAL_K=3
HYBRID_ALPHA=0.5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Storage ───────────────────────────────────────────────────
DATA_DIR=data
